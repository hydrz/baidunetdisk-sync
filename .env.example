# 本地要同步的文件夹路径（默认是 ~/.baidunetdisk）
LOCAL_SYNC_DIR=~/.baidunetdisk

# OpenList Web 访问端口
OPENLIST_PORT=5244

# OpenList 管理员默认密码（启动后可在后台修改）
OPENLIST_ADMIN_PASSWORD=admin123

# WebDAV 连接认证信息
WEBDAV_USER=admin
WEBDAV_PASSWORD=admin123

# 同步空间挂载在 OpenList 内部的虚拟路径
WEBDAV_WORKSPACE_PATH=workspace

# 双向自动增量同步的时间间隔（秒，默认 300 秒即 5 分钟）
SYNC_INTERVAL=300

# 百度网盘客户端登录凭证（可运行 python3 scripts/extract-cookie.py 自动生成）
BAIDU_BDUSS=""
