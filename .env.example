# 本地要同步的文件夹路径（主机端绝对路径）
LOCAL_SYNC_DIR=/home/nan/.baidunetdisk

# 百度网盘云端同步空间根路径（默认 /_pcs_.workspace）
REMOTE_ROOT=/_pcs_.workspace

# 双向自动增量同步的时间间隔（秒，默认 300 秒即 5 分钟）
SYNC_INTERVAL=300

# 并发工作线程数
CONCURRENCY=16

# 百度网盘授权凭证
# 打开 https://api.oplist.org/ 选择百度网盘授权后，复制 refresh_token 填入下方即可
BAIDU_REFRESH_TOKEN=""
